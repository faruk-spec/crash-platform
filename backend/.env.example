DB_PASSWORD=your_secure_password_here

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# GitHub App / CI Integration
GITHUB_REPO_OWNER=your-username
GITHUB_REPO_NAME=crash-platform
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_fine_grained_token_here
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# Firebase Cloud Messaging (for in-app update push)
FCM_SERVER_KEY=your_fcm_server_key_here

# Prediction & Analysis Settings
PREDICTOR_DEFAULT_CONFIDENCE=0.75
PREDICTOR_DEFAULT_MODE=BEFORE_5X
AUTO_SYNC_INTERVAL_SECONDS=30

